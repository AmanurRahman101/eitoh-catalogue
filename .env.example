# EiToh Studio Full-Stack Configuration Example
PORT=5000
NODE_ENV=development

# MySQL Database Settings (Individual parameters OR single Connection URL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eitoh_db
DB_PORT=3306
DB_SSL=false

# Alternatively, for Cloud Deployments (Railway, Render, TiDB, Aiven, Supabase):
# MYSQL_URL=mysql://root:password@containers-us-west-123.railway.app:3306/railway
# DATABASE_URL=mysql://root:password@containers-us-west-123.railway.app:3306/railway

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@eitoh.com
DEFAULT_ADMIN_PASSWORD=admin1234
DEFAULT_ADMIN_NAME=EiToh Admin Studio
DEFAULT_ADMIN_PHONE=01777547605
